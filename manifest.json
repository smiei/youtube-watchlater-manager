{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "smiei",
  "homepage_url": "https://github.com/smiei/youtube-watchlater-manager",
  "icons": {
    "48": "assets/icon.svg",
    "96": "assets/icon.svg",
    "128": "assets/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube_watch_later_manager.user.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "watchlater-playlist-manager@addons.mozilla.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
